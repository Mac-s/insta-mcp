# --- docker-compose.yml variables ---

# Public HTTPS address of this server, as your reverse proxy serves it (no trailing slash).
# The MCP endpoint Claude uses is this URL + /mcp.
INSTA_MCP_PUBLIC_URL=https://insta-mcp.example.com

# Token from Meta's dashboard (Instagram > API setup with Instagram login > Generate token).
# Only read on first start or when it changes; refreshed tokens are kept in /data.
INSTA_MCP_IG_TOKEN=

# Password typed on the /login page when Claude connects (16+ characters).
# Generate one with: openssl rand -base64 24
INSTA_MCP_ADMIN_PASSWORD=

# --- Variables read by the server itself (outside docker-compose) ---
# PUBLIC_URL, IG_ACCESS_TOKEN, MCP_ADMIN_PASSWORD, and optionally:
# MCP_STATIC_TOKEN   fixed bearer token (32+ chars) accepted alongside OAuth
# IG_GRAPH_HOST      default graph.instagram.com
# IG_GRAPH_VERSION   default v21.0
# Each secret can also be read from a file with the _FILE suffix
# (e.g. IG_ACCESS_TOKEN_FILE=/run/secrets/ig_access_token).
